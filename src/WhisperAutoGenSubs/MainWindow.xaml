<Window x:Class="WhisperAutoGenSubs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper Auto Gen Subs"
        Height="960" Width="1180" MinHeight="720" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Whisper Auto Gen Subs" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                       Text="Local, offline English subtitle generation. No OpenSubtitles or web services. GPU is used when the selected whisper-cli supports CUDA." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Video library" />
            <TextBox x:Name="LibraryPathTextBox" Grid.Column="1" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="2" Padding="16,6" Margin="0,0,8,0" Content="Browse…" Click="BrowseLibrary_Click" />
            <Button x:Name="ScanButton" Grid.Column="3" Padding="16,6" Content="Scan" Click="ScanButton_Click" />
        </Grid>

        <StackPanel Grid.Row="2">
            <GroupBox Header="Offline engine — local files only" Margin="0,0,0,14" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="ffmpeg.exe" />
                    <TextBox x:Name="FfmpegPathTextBox" Grid.Row="0" Grid.Column="1" MinHeight="30" VerticalContentAlignment="Center" Margin="0,0,8,6" />
                    <Button Grid.Row="0" Grid.Column="2" Padding="16,5" Margin="0,0,0,6" Content="Browse…" Click="BrowseFfmpeg_Click" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="whisper-cli.exe" />
                    <TextBox x:Name="WhisperCliPathTextBox" Grid.Row="1" Grid.Column="1" MinHeight="30" VerticalContentAlignment="Center" Margin="0,0,8,6" />
                    <Button Grid.Row="1" Grid.Column="2" Padding="16,5" Margin="0,0,0,6" Content="Browse…" Click="BrowseWhisperCli_Click" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="English Whisper model" />
                    <TextBox x:Name="ModelPathTextBox" Grid.Row="2" Grid.Column="1" MinHeight="30" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="For fastest generation choose a local tiny.en model." />
                    <Button Grid.Row="2" Grid.Column="2" Padding="16,5" Content="Browse…" Click="BrowseModel_Click" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Live instrument panel" Margin="0,0,0,14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock x:Name="CurrentFileTextBlock" FontWeight="SemiBold" Text="No file is being processed." TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PhaseTextBlock" Margin="0,3,0,0" Foreground="DimGray" Text="Waiting" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="FileProgressBar" Height="18" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="FilePercentTextBlock" Grid.Column="1" Width="55" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="—" />
                    </Grid>

                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="DimGray" Text="Estimated remaining" />
                            <TextBlock x:Name="EtaTextBlock" FontSize="18" Text="Waiting for measurement…" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="DimGray" Text="Speed" />
                            <TextBlock x:Name="SpeedTextBlock" FontSize="18" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="DimGray" Text="Actual engine" />
                            <TextBlock x:Name="EngineTextBlock" FontSize="18" Text="Not started" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="WorkerCpuTextBlock" Text="Active process CPU: —" />
                            <ProgressBar x:Name="WorkerCpuBar" Height="8" Margin="0,4,0,0" Minimum="0" Maximum="100" />
                            <TextBlock x:Name="SystemCpuTextBlock" Margin="0,4,0,0" Foreground="DimGray" Text="Whole PC CPU: —" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="WorkerGpuTextBlock" Text="Active process GPU: waiting for Windows counter…" />
                            <ProgressBar x:Name="WorkerGpuBar" Height="8" Margin="0,4,0,0" Minimum="0" Maximum="100" />
                            <TextBlock x:Name="TotalGpuTextBlock" Margin="0,4,0,0" Foreground="DimGray" Text="Whole GPU (busiest engine): —" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>
        </StackPanel>

        <DataGrid x:Name="VideoGrid" Grid.Row="3" ItemsSource="{Binding Videos}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Video" Binding="{Binding FileName}" Width="3*" />
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" />
                <DataGridTextColumn Header="Subtitle" Binding="{Binding SubtitleDisplay}" Width="2*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock" Text="Choose a video library, then scan." />
                <ProgressBar x:Name="ProgressBar" Margin="0,6,12,0" Height="6" Minimum="0" Maximum="1" Value="0" />
            </StackPanel>
            <TextBlock x:Name="CountTextBlock" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Foreground="DimGray" Text="0 videos" />
            <Button x:Name="GenerateButton" Grid.Column="2" Padding="16,6" Margin="0,0,8,0" Content="Generate missing subtitles" Click="GenerateButton_Click" />
            <Button x:Name="CancelButton" Grid.Column="3" Padding="16,6" Content="Cancel" IsEnabled="False" Click="CancelButton_Click" />
        </Grid>
    </Grid>
</Window>
